---
layout: base.liquid
---

{% assign sorted_posts = collections.posts | sort: 'data.date' | reverse %}
Tip: for the RSS users out there, subscribe to post updates <a href="https://danhinze.com/feed.xml">here</a>.
<hr>
{% for post in sorted_posts %}
<div>
  <ul class="posts-list">
    <strong><a href="{{ post.url }}">{{ post.data.title }}</a></strong>{% if isDev and post.data.draft %} <span class="draft-label">[DRAFT]</span>{% endif %}
    {% if post.data.subtitle %}<div>{{ post.data.subtitle }}</div>{% endif %}
    <div>{{ post.data.date | date: '%b %d, %Y', 'utc' }}</div>
  </ul>
</div>
{% endfor %}
